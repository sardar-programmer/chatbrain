{
  "name": "chat-brain",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"UI,API\" -c \"cyan,magenta\" \"vite\" \"node scripts/dev-api.mjs\"",
    "dev:ui": "vite",
    "dev:api": "node scripts/dev-api.mjs",
    "setup:api": "node scripts/setup-api.mjs",
    "test:api": "node scripts/test-api.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\""
  },
  "dependencies": {
    "@fontsource/inter": "5.1.0",
    "@fontsource/jetbrains-mono": "5.1.1",
    "@fontsource/newsreader": "5.1.0",
    "@monaco-editor/react": "4.6.0",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-dropdown-menu": "2.1.4",
    "@radix-ui/react-popover": "1.1.4",
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-tabs": "1.1.2",
    "@radix-ui/react-tooltip": "1.1.6",
    "@tanstack/react-query": "5.64.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "highlight.js": "11.11.1",
    "lowlight": "3.1.0",
    "lucide-react": "0.469.0",
    "monaco-editor": "0.52.2",
    "plotly.js-cartesian-dist-min": "2.35.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "9.0.3",
    "react-plotly.js": "2.6.0",
    "react-router-dom": "6.28.1",
    "remark-gfm": "4.0.0",
    "tailwind-merge": "2.6.0",
    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/node": "22.10.7",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@typescript-eslint/eslint-plugin": "8.19.1",
    "@typescript-eslint/parser": "8.19.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "concurrently": "10.0.6",
    "eslint": "8.57.1",
    "eslint-plugin-react-hooks": "5.1.0",
    "jsdom": "25.0.1",
    "postcss": "8.4.49",
    "prettier": "3.4.2",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "vite": "6.0.7",
    "vitest": "2.1.8"
  }
}
